#!/bin/bash
# JSON snapshot for the omany panel: slots, installed agents, agents running in
# the Herdr workspace, and settings. Never runs an agent binary.

set -uo pipefail
# shellcheck source=omany-settings
source "$(dirname "$(readlink -f "$0")")/omany-settings"

herdr_cmd=(herdr)
[[ -n $OMANY_SESSION ]] && herdr_cmd+=(--session "$OMANY_SESSION")

default=$(omany_default_agent)
omarchy_default=$(omarchy-default-agent 2>/dev/null)
other=$([[ -n $default ]] && omany_other_agent "$default")

agents="[]"
for a in "${OMANY_AGENTS[@]}"; do
  agents=$(jq -c --arg n "$a" --arg s "$(omany_agent_state "$a")" '. + [{name: $n, state: $s}]' <<<"$agents")
done

online=false
running="[]"
if command -v herdr >/dev/null && workspaces=$("${herdr_cmd[@]}" workspace list 2>/dev/null); then
  online=true
  ws=$(jq -r --arg l "$OMANY_WORKSPACE" '.result.workspaces[] | select(.label == $l) | .workspace_id' <<<"$workspaces" | head -n1)
  if [[ -n $ws ]]; then
    running=$("${herdr_cmd[@]}" agent list 2>/dev/null | jq -c --arg ws "$ws" \
      '[.result.agents[]? | select(.workspace_id == $ws)
        | {name: (.name // ((.agent // "agent") + " (unnamed)")), target: (.name // .pane_id),
           status: (.agent_status // "unknown"), pane: .pane_id}]') || running="[]"
  fi
fi

jq -n \
  --arg default "$default" --arg other "$other" --arg omarchyDefault "$omarchy_default" \
  --arg slotA "$OMANY_SLOT_A" --arg otherSetting "$OMANY_OTHER_AGENT" \
  --arg slotS "$OMANY_SLOT_S" --arg slotX "$OMANY_SLOT_X" \
  --arg workspace "$OMANY_WORKSPACE" --arg cwd "$OMANY_CWD" \
  --arg loadSkill "$OMANY_LOAD_SKILL" \
  --arg position "$(omany_bar position)" \
  --argjson agents "$agents" --argjson running "$running" --argjson online "$online" \
  '{default: $default, other: $other, omarchyDefault: $omarchyDefault,
    slots: {a: $slotA, z: $otherSetting, s: $slotS, x: $slotX},
    agents: $agents, online: $online, running: $running,
    settings: {workspace: $workspace, cwd: $cwd, loadSkill: ($loadSkill == "true"),
               position: (if $position == "" then "center" else $position end)}}'
